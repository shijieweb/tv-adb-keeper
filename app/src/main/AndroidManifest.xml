<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:label="ADB 常开"
        android:supportsRtl="false">
        <!-- 两个 category 都要有：
             LAUNCHER        —— 普通桌面能看到。
             LEANBACK_LAUNCHER —— 实测本机电视桌面（com.gathin.tvhome）的「常用」应用列表
                                 只列带 LEANBACK 的应用，少了这个老板用遥控器根本找不到本 App，
                                 App 被系统停掉后就没法自助拉起来。 -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只为把系统的投屏授权框顶出来；自身透明、无布局，拿到结果立刻退出。
             注意：这里不能用 noHistory="true" —— 授权框一出来本 Activity 就 stop，
             noHistory 会把它直接销毁，onActivityResult 收不到，投屏就永远起不来。 -->
        <activity
            android:name=".ProjectionRequestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <service android:name=".KeeperService" android:exported="false" />

        <!-- 第三条腿：persisted job（写进 /data/system/job/，重启后由 JobSchedulerService
             主动重排，不走 BOOT_COMPLETED 广播，厂商拦不住）。 -->
        <service
            android:name=".KeeperJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 关键：开机时由 system_server 的 AccessibilityManagerService 按 settings 里
             持久化的 enabled_accessibility_services 列表主动绑定，绕开厂商对第三方
             App 自启动（BOOT_COMPLETED）的拦截。本服务不做任何界面朗读。 -->
        <service
            android:name=".KeeperA11yService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/keeper_a11y" />
        </service>

        <receiver android:name=".BootReceiver" android:exported="true" android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
